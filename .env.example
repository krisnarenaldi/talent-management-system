# ============================================================
# TMS — Environment Variables Template
# Salin file ini ke .env dan isi nilainya sesuai environment.
# JANGAN pernah commit file .env ke git.
# ============================================================

# ── App ──────────────────────────────────────────────────────
# Nilai: development | production
ENVIRONMENT=development

# URL frontend yang diizinkan di CORS (backend FastAPI)
# Pisahkan dengan koma jika lebih dari satu, misal: http://localhost:3000,https://tms.example.com
FRONTEND_URL=http://localhost:3000

# Level log aplikasi (debug | info | warning | error)
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────
# Nama database, user, dan password PostgreSQL.
# Di dalam Docker, POSTGRES_HOST=postgres (nama service di docker-compose).
# Untuk koneksi langsung dari luar container gunakan: POSTGRES_HOST=localhost
POSTGRES_DB=tms_db
POSTGRES_USER=tms_user
POSTGRES_PASSWORD=change_me_strong_password_here

# ── PgBouncer (Connection Pooling) ──────────────────────────
# Backend FastAPI terhubung ke PgBouncer (bukan langsung ke Postgres).
# Di dalam Docker: PGBOUNCER_HOST=pgbouncer, port=6432
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# ── FastAPI / Auth ───────────────────────────────────────────
# SECRET_KEY: kunci untuk sign JWT — minimal 32 karakter acak.
# Generate dengan: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ALGORITHM=HS256

# Durasi token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Shared secret antara n8n dan FastAPI untuk endpoint /internal/*.
# Harus sama persis dengan nilai yang dikonfigurasi di n8n workflow.
# Generate dengan: openssl rand -hex 32
INTERNAL_API_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Next.js (Frontend) ───────────────────────────────────────
# URL API yang diakses dari browser (public).
# Di production, gunakan domain asli: https://tms.example.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# ── Microsoft Graph API (OneDrive for Business) ──────────────
# Dibutuhkan untuk upload/download dokumen kandidat & karyawan (FR-03, FR-11).
# Cara mendapat nilai ini:
#   1. Buka Azure Portal → App Registrations → New registration
#   2. Tambah permission: Files.ReadWrite.All (Application, bukan Delegated)
#   3. Buat Client Secret di Certificates & Secrets
#   4. ONEDRIVE_DRIVE_ID: ID drive SharePoint/OneDrive target (bukan user drive)
MICROSOFT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=change_me_azure_client_secret_value
ONEDRIVE_DRIVE_ID=b!xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Folder root di OneDrive tempat semua dokumen TMS disimpan
ONEDRIVE_ROOT_FOLDER=TMS_Documents

# ── n8n (Workflow Automation) ────────────────────────────────
# Kredensial untuk login ke UI n8n (Basic Auth via Nginx)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_ui_password

# Kunci enkripsi credential n8n — jangan ubah setelah pertama setup, akan merusak credentials tersimpan.
# Generate dengan: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# Base URL n8n untuk webhook callback dari luar container.
# Di dalam Docker (backend → n8n): http://n8n:5678
# Di production (webhook dari LLM provider keluar): https://tms.example.com/n8n
N8N_WEBHOOK_BASE_URL=http://n8n:5678

# URL webhook spesifik tiap workflow n8n (isi setelah workflow dibuat di UI n8n)
N8N_WEBHOOK_CV_PARSER=http://n8n:5678/webhook/cv-parser
N8N_WEBHOOK_AI_SCREENING=http://n8n:5678/webhook/ai-screening

# ── LLM API (Fase 3 — AI Screening & Ekstraksi) ──────────────
# Minimal pilih satu provider. Uncomment yang dipakai.
# Default: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-change_me_your_anthropic_api_key
LLM_MODEL=claude-haiku-4-5

# OpenAI (opsional, uncomment jika dipakai)
# OPENAI_API_KEY=sk-change_me_your_openai_api_key

# Google AI (opsional, uncomment jika dipakai)
# GOOGLE_AI_API_KEY=change_me_your_google_ai_api_key

# ── Domain & SSL (Production) ────────────────────────────────
# Domain aktual untuk Nginx dan Let's Encrypt.
# Wajib diisi sebelum deploy ke production.
# Juga update: nginx.conf → server_name
APP_DOMAIN=tms.example.com
