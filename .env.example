# ============================================================
# TMS — Environment Variables Template
# Copy file ini ke .env dan isi nilainya
# JANGAN commit file .env ke git
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tms_db
POSTGRES_USER=tms_user
POSTGRES_PASSWORD=your_strong_password_here

# --- PgBouncer ---
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# --- FastAPI ---
SECRET_KEY=your_jwt_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_API_SECRET=shared_secret_for_n8n_callbacks

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXTAUTH_SECRET=your_nextauth_secret

# --- Microsoft Graph API (OneDrive for Business) ---
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_CLIENT_SECRET=your_client_secret
ONEDRIVE_DRIVE_ID=your_sharepoint_drive_id
ONEDRIVE_ROOT_FOLDER=TMS_Documents

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password
N8N_ENCRYPTION_KEY=your_n8n_encryption_key
N8N_WEBHOOK_BASE_URL=http://n8n:5678
# Webhook URLs (diisi setelah workflow n8n dibuat)
N8N_WEBHOOK_CV_PARSER=http://n8n:5678/webhook/cv-parser
N8N_WEBHOOK_AI_SCREENING=http://n8n:5678/webhook/ai-screening

# --- LLM API (pilih salah satu atau lebih) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key
# GOOGLE_AI_API_KEY=your_google_ai_api_key
LLM_MODEL=claude-haiku-4-5

# --- App ---
ENVIRONMENT=development
# ENVIRONMENT=production
FRONTEND_URL=http://localhost:3000
